# Exclude hidden local/tooling state from the image context.
.*
!.dockerignore
!.env.example
node_modules/
web-admin/node_modules/
.deploy-backup/
.oss-dist/
.oss-publish/
bailinghub-*.tgz
!vendor/bailinghub-mammoth-library-1.12.0-bailinghub.1.tgz
*.bak.*
*.bak.*/
src.bak.*/
web/site/
web/site-dist/
deploy/
data/
config.json
.env
.paused
build-info.json
*.log
.DS_Store
._*
web/console/
web/console.bak.*/
brain/profiles.local.json
brain/**/*.local.json
brain/**/*.local.md
internal/
*.internal.md
*.private.md
private/
enterprise/
src/private/
src/enterprise/
sql/private/
sql/enterprise/
web-admin/src/private/
web-admin/src/platform/
*.private.*
*.enterprise.*

# Repository governance metadata; excluded from runtime distributions.
security-insights.yml
SECURITY_SELF_ASSESSMENT*.md
docs/security-assessment*
docs/security/self-assessment*
